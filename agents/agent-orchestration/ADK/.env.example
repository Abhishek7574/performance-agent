# ══════════════════════════════════════════════════════════════════════════════
# ADK Agent Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Required for LLM-powered agent orchestration
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=<your-gpt4o-deployment-name>
AZURE_OPENAI_API_VERSION=2024-02-01

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for web UI
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Tool Service URLs ─────────────────────────────────────────────────────────
# Override these for Azure deployment (defaults work for local development)
PERFORMANCE_TOOL_URL=http://localhost:6103
PROCESS_MONITOR_URL=http://localhost:6104
SECURITY_MONITOR_URL=http://localhost:6105
LOG_ANALYTICS_URL=http://localhost:6106
APPLICATION_MONITOR_URL=http://localhost:6107
DASHBOARD_TOOL_URL=http://localhost:6108
CLOUDLENS_IAC_TOOL_URL=http://localhost:6212
RAGSEARCH_URL=http://localhost:8002
FILE_COUNT_URL=http://localhost:6110
FILE_SEARCH_URL=http://localhost:6111

# ── Doppelio Load Testing ─────────────────────────────────────────────────────
# API Configuration
DOPPELIO_TOKEN=<your-doppelio-api-token>
DOPPELIO_WEB_API_BASE=https://api.doppelio.com/doppelioWebAPI/api
DOPPELIO_CORE_BASE=https://api.doppelio.com/doppelio/api
DOPPELIO_WORKSPACE=AiTemp

# SSL Verification (set to 'true' in production)
DOPPELIO_VERIFY_SSL=false

# Telemetry & Monitoring
DOPPELIO_FUNCTION_APP_ENDPOINT=http://localhost:7071/ingest
DOPPELIO_POLL_INTERVAL_SECS=30
DOPPELIO_POST_TEST_DELAY_SECS=180

# Download Settings
DOPPELIO_DOWNLOAD_MAX_RETRIES=10
DOPPELIO_DOWNLOAD_RETRY_INTERVAL_SECS=120

# CSV Configuration
DOPPELIO_SAMPLE_CSV_PATH=doppel_sample.csv
DOPPELIO_CSV_ID_COLUMN=device_id
DOPPELIO_CSV_UPLOAD_DIR=/tmp/doppelio_uploads

# ── Azure Monitor MCP Server ──────────────────────────────────────────────────
# Used by Platform Monitor Agent for metrics retrieval
AZURE_MONITOR_MCP_URL=http://localhost:6200

# ── FinOps: idle-service cost optimization ────────────────────────────────────
# The SRE agent proactively scans the known services for low utilization and
# suggests stopping idle ones (user-approved + AGENTIC_STOP_ALLOWLIST gated).
FINOPS_IDLE_WINDOW_DAYS=7          # look-back window for "idle" assessment
FINOPS_IDLE_CPU_PCT=5             # avg CPU% at/below this counts as idle (where applicable)
FINOPS_IDLE_ACTIVITY_MAX=1        # total requests/messages at/below this counts as idle
FINOPS_SCAN_INTERVAL_HOURS=24    # background scan cadence (min effective 60s)
FINOPS_SCAN_INITIAL_DELAY_SECS=120  # delay before first scan so tools are up
# CLOUDLENS_TOOL_URL=http://localhost:6212   # used by the idle-scan loop (defaults to :6212)

# ══════════════════════════════════════════════════════════════════════════════
# NOTE: Azure authentication (AZURE_TENANT_ID, AZURE_CLIENT_ID, 
# AZURE_CLIENT_SECRET, AZURE_SUBSCRIPTION_ID) should be configured at the 
# project root level or via Azure App Service application settings
# ══════════════════════════════════════════════════════════════════════════════
